<h2 class="mb-4">
Add Institution
</h2>

<form action="/admin/institutions" method="POST">

<div class="mb-3">
<label>Name</label>
<input
name="name"
class="form-control"
required>
</div>

<div class="mb-3">
<label>Short Name</label>
<input
name="shortName"
class="form-control">
</div>

<div class="mb-3">
<label>City</label>
<input
name="city"
class="form-control"
required>
</div>

<div class="mb-3">
<label>State</label>
<input
name="state"
class="form-control"
required>
</div>

<button class="btn btn-success">
Add Institution
</button>

</form>